{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "copilot": [
      "rules",
      "skills",
      "subagents",
      "commands"
    ],
    "copilotcli": [
      "rules",
      "skills",
      "subagents"
    ],
    "codexcli": [
      "skills",
      "subagents"
    ],
    "claudecode": {
      "rules": {
        "includeRoot": false
      },
      "skills": true,
      "commands": true,
      "subagents": true
    },
    "antigravity-ide": [
      "rules",
      "skills",
      "subagents",
      "commands"
    ],
    "antigravity-cli": [
      "rules",
      "skills",
      "subagents",
      "commands"
    ],
    "androidstudio": [
      "skills"
    ],
    "agentsskills": [
      "skills"
    ]
  },
  "outputRoots": [
    "."
  ],
  "delete": false,
  "verbose": false,
  "silent": false
}
