#!/usr/bin/env bash
set -euo pipefail
cd "$(cd "$(dirname "$0")/.." && pwd)"

contracts=(AGENTS.md CHATBOT.md CLAUDE.md GEMINI.md)
generated=(
  .github/copilot-instructions.md .github/instructions .github/agents .github/skills
  .agents/rules .agents/agents .agents/skills .codex/skills
  .claude/rules .claude/skills .gemini/skills
)
fingerprint_contracts(){
  local path
  for path in "${contracts[@]}"; do
    git hash-object -- "$path" || return 1
  done
}
check_ownership(){
  local path tracked unignored
  for path in "${contracts[@]}"; do
    git ls-files --error-unmatch -- "$path" >/dev/null 2>&1 ||
      { echo "직접 관리 계약은 Git 추적되어야 합니다: $path" >&2; return 1; }
    if git check-ignore -q -- "$path"; then
      echo "직접 관리 계약이 무시됨: $path" >&2; return 1
    fi
  done
  tracked="$(git ls-files -- "${generated[@]}")"
  if [[ -n "$tracked" ]]; then
    echo "도구별 생성물이 Git에 추적됨: $tracked" >&2; return 1
  fi
  unignored="$(git ls-files --others --exclude-standard -- "${generated[@]}")"
  if [[ -n "$unignored" ]]; then
    echo "생성물 무시 누락: $unignored" >&2; return 1
  fi
}
before="$(fingerprint_contracts)"
case "${1:-}" in
  install)
    bash scripts/rulesync install --frozen
    ;;
  generate)
    bash scripts/rulesync install --frozen
    bash scripts/rulesync generate
    node scripts/agent-route-index.mjs generate
    ;;
  check)
    bash scripts/rulesync install --frozen
    bash scripts/rulesync doctor --strict
    bash scripts/rulesync generate
    node scripts/agent-route-index.mjs check
    ;;
  update)
    echo "현재 외부 소스 0개: update는 별도 승인·소스 잠금 검토 이후 도입합니다" >&2
    exit 2
    ;;
  *)
    echo "사용법: bash scripts/rulesync-assets install|generate|check|update" >&2
    exit 2
    ;;
esac
after="$(fingerprint_contracts)"
if [[ "$before" != "$after" ]]; then
  echo "Rulesync가 직접 관리하는 진입 문서를 변경했습니다. 변경물을 검토하세요." >&2
  exit 1
fi
check_ownership
