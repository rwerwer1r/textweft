#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
check_ownership() {
  git ls-files --error-unmatch AGENTS.md >/dev/null 2>&1 || {
    echo "AGENTS.md는 Git 추적 정본이어야 합니다." >&2; return 1;
  }
  if git check-ignore -q AGENTS.md; then
    echo "AGENTS.md는 Git 무시 대상일 수 없습니다." >&2; return 1
  fi
  local tracked unignored
  for path in ".github/copilot-instructions.md" ".github/instructions" ".github/skills" ".agents/rules" ".agents/skills" ".codex/skills"; do
    tracked="$(git ls-files -- "$path" || true)"
    if [[ -n "$tracked" ]]; then
      echo "Rulesync 생성물 Git 추적 금지: $tracked" >&2; return 1
    fi
    unignored="$(git ls-files --others --exclude-standard -- "$path" || true)"
    if [[ -n "$unignored" ]]; then
      echo "Rulesync 생성물이 무시 범위 밖에 있습니다: $unignored" >&2; return 1
    fi
  done
}
case "$*" in
  install)
    exec bash scripts/rulesync install --frozen
    ;;
  generate)
    bash scripts/rulesync install --frozen
    bash scripts/rulesync generate
    node scripts/agent-route-index.mjs generate
    check_ownership
    ;;
  check)
    bash scripts/rulesync install --frozen
    bash scripts/rulesync doctor --strict
    before="$(git hash-object AGENTS.md)"
    bash scripts/rulesync generate
    node scripts/agent-route-index.mjs check
    check_ownership
    after="$(git hash-object AGENTS.md)"
    if [[ "$before" != "$after" ]]; then
      echo "Rulesync가 직접 관리하는 AGENTS.md를 변경했습니다" >&2; exit 1
    fi
    ;;
  update)
    bash scripts/rulesync install --update
    bash scripts/rulesync generate
    node scripts/agent-route-index.mjs generate
    check_ownership
    ;;
  *)
    echo "사용법: bash scripts/rulesync-assets install|generate|check|update" >&2
    exit 2
    ;;
esac
