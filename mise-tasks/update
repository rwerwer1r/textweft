#!/usr/bin/env bash
#MISE description="프로젝트에 고정된 도구·npm 의존성·Git 훅을 현재 환경에 동기화"
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$root"
if [[ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$root" ]]; then
  echo "오류: Textweft 저장소 루트에서만 환경을 갱신할 수 있습니다." >&2
  exit 1
fi

# Bootstrap must not silently resolve or rewrite dependencies.
if [[ ! -f package-lock.json ]]; then
  echo "오류: package-lock.json이 없습니다. npm install --package-lock-only로 잠금을 생성·검토·커밋한 뒤 다시 실행하세요." >&2
  exit 1
fi

mise install
# Check upstream lock integrity before changing npm modules or Git hooks.
mise run rulesync:install
npm ci
lefthook install
mise run rulesync:generate

# Antigravity는 .gitignore에 포함된 .agents/rules·skills를 읽지 않을 수 있습니다.
# 생성 자산은 이 저장소의 로컬 Git exclude에서만 숨깁니다 (기존 항목 보존).
local_exclude="$(git rev-parse --git-path info/exclude)"
mkdir -p "$(dirname "$local_exclude")"
touch "$local_exclude"
for generated in '/.agents/rules/*' '/.agents/agents/*' '/.agents/skills/*'; do
  if ! grep -Fqx -- "$generated" "$local_exclude"; then
    printf '%s\n' "$generated" >> "$local_exclude"
  fi
done

# 벤더 전용 루트 진입점은 Git에 보존하지 않고 로컬에서만 준비합니다.
# 기존 개인 설정·심볼릭 링크는 덮어쓰지 않습니다.
for entry in CLAUDE.md GEMINI.md; do
  if [[ ! -e "$entry" && ! -L "$entry" ]]; then
    cat > "$entry" <<'EOF'
# Local Agent Entry

Read [AGENTS.md](AGENTS.md) first. Choose only relevant Rules and Skills via
[ROUTE](.agents/route/ROUTE.md) and project instructions via
[Development](docs/development/README.md).
EOF
  fi
done
echo "개발 환경·하네스 동기화 완료. 검사: mise run check"
