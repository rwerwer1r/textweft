#!/usr/bin/env bash
#MISE description="Textweft 개발 환경 최초 설정(도구·의존성·훅·로컬 커밋 템플릿)"
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$root"

# Do not change global Git settings or the author's identity.
mise run update
git config --local commit.template "$root/.gitmessage"
echo "초기 셋업 완료. 커밋 템플릿은 이 저장소에만 적용됩니다."
